#!/bin/sh

set -u

HELPER="/var/packages/AQC_Unlock/target/bin/helper/aqcunlock-helper"
DEGRADED_MARKER="/var/packages/AQC_Unlock/var/state/helper_degraded"
OLD_DEGRADED_MARKER="/var/packages/AQC_Unlock/var/state/no_sudo_degraded"
LOG_FILE="/var/packages/AQC_Unlock/var/aquantia.log"

# aquantia.log is owned by AQC_Unlock, not root, so the wrapper can write
# here directly even when the helper isn't usable - gives one unified
# timeline instead of splitting the story across just the DSM popup and /tmp.
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE" 2>/dev/null || true
}

write_permission_message() {
    if [ -z "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        return 0
    fi

    script_dir=$(/usr/bin/dirname "$0")
    if [ -f "${script_dir}/lang/${SYNOPKG_DSM_LANGUAGE:-enu}" ]; then
        . "${script_dir}/lang/${SYNOPKG_DSM_LANGUAGE:-enu}"
    else
        . "${script_dir}/lang/enu"
    fi

    # PKG_HELPER_MISSING should be added to the lang files; the English
    # fallback keeps this working until it is.
    echo "${PKG_HELPER_MISSING:-AQC Unlock started, but its privileged helper is not active so the network card is not unlocked yet. Click Open for details, then try reinstalling AQC Unlock in Package Center.}" > "$SYNOPKG_TEMP_LOGFILE"
}

# log and killall are no-ops in start-stop-status-root, so there is no need
# to escalate for them. Anything unrecognised was also a silent exit 0 before.
case "${1:-}" in
    start|stop|status) ;;
    *) exit 0 ;;
esac

# Helper missing or not executable (e.g. package files damaged).
helper_usable=1
[ -x "$HELPER" ] || helper_usable=0

_output=""
_status=0
if [ "$helper_usable" -eq 1 ]; then
    _output=$("$HELPER" "$@" 2>&1)
    _status=$?
    # Every helper-side failure (not setuid, setuid/setgid failed, exec
    # failed) prints a line starting "aqcunlock-helper:". The root script
    # never does, so this can't be confused with the script's own exit code
    # (which can legitimately be 1, 126 or 127 under set -e).
    if echo "$_output" | grep -q "^aqcunlock-helper:"; then
        helper_usable=0
    fi
fi

if [ "$helper_usable" -eq 0 ]; then
    mkdir -p "$(dirname "$DEGRADED_MARKER")" 2>/dev/null || true
    touch "$DEGRADED_MARKER" 2>/dev/null || true

    case "$1" in
        start)
            log_message "helper unavailable (start) - ${_output:-helper missing or not executable}, degrading gracefully"
            write_permission_message
            # Report success to DSM rather than tripping the install/start
            # failure -> "Repair" flow. The popup carries the real information;
            # nothing privileged has actually run yet.
            exit 0
            ;;
        stop)
            log_message "helper unavailable (stop) - nothing was actually running, nothing to stop"
            exit 0
            ;;
        status)
            # Match what 'start' just reported, so DSM doesn't immediately flip
            # back to "stopped"/broken on its next status poll. Deliberately
            # not logged - status is polled frequently.
            exit 0
            ;;
    esac
fi

# The helper ran the real command - clear any stale degraded markers (this
# package's old sudo-based one included) and any stale popup message from a
# previous failed start, then pass through the command's output and exit
# code. (DSM's own startFailed marker is cleared inside
# start-stop-status-root itself, since it needs root.)
rm -f "$DEGRADED_MARKER" "$OLD_DEGRADED_MARKER" 2>/dev/null || true
if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
    : > "$SYNOPKG_TEMP_LOGFILE" 2>/dev/null || true
fi
[ -n "$_output" ] && echo "$_output"
exit "$_status"
